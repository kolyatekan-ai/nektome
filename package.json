{
  "name": "burmalda",
  "version": "1.0.0",
  "private": true,
  "description": "Burmalda — Discord-like real-time messenger (MVP)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @burmalda/api dev\" \"pnpm --filter @burmalda/web dev\"",
    "build": "pnpm -r build",
    "start": "concurrently -n api,web -c blue,green \"pnpm --filter @burmalda/api start\" \"pnpm --filter @burmalda/web start\"",
    "db:migrate": "pnpm --filter @burmalda/api db:migrate",
    "db:generate": "pnpm --filter @burmalda/api db:generate",
    "db:seed": "pnpm --filter @burmalda/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.x"
  }
}
